{
  "name": "sellerkit-site",
  "private": true,
  "description": "No build step for the site. This file only runs the checks and rebuilds the vendored Sentry bundle.",
  "scripts": {
    "check": "node tests/check.mjs",
    "check:static": "node tests/check.mjs --static",
    "vendor:sentry": "esbuild tools/sentry/entry.js --bundle --minify --format=iife --global-name=Sentry --target=es2019 --legal-comments=eof --outfile=sentry.min.js"
  },
  "devDependencies": {
    "@sentry/browser": "10.75.3",
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  }
}
